generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal connectivity model used for health checks.
/// Not tied to future business features and safe to remove later.
model AppHealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  note      String
}

model Trip {
  id                  Int                @id @default(autoincrement())
  name                String             @db.VarChar(200)
  origin              String             @db.VarChar(200)
  destination         String             @db.VarChar(200)
  originTimeZone      String             @db.VarChar(100)
  destinationTimeZone String             @db.VarChar(100)
  departureAt         DateTime
  arrivalAt           DateTime
  notes               String?            @db.VarChar(2000)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  flightSegments      FlightSegment[]
  recoveryPlans       RecoveryPlan[]
  personalActivities  PersonalActivity[]
}

/// A user's own planned activity (e.g. a meeting) shown on the plan calendar.
/// Linked to the trip, not a recovery plan, so regenerating or adjusting a plan
/// never removes it.
model PersonalActivity {
  id        Int      @id @default(autoincrement())
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(120)
  notes     String?  @db.VarChar(500)
  startsAt  DateTime
  endsAt    DateTime
  /// IANA zone the activity was entered in; times display in this zone.
  timeZone  String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, startsAt])
}

/// Which half of a round trip a flight or recovery plan belongs to.
enum JourneyLeg {
  outbound
  return
}

model FlightSegment {
  id                   Int                   @id @default(autoincrement())
  tripId               Int
  trip                 Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  leg                  JourneyLeg            @default(outbound)
  airline              String?               @db.VarChar(120)
  flightNumber         String?               @db.VarChar(32)
  departureAirportCode String                @db.VarChar(3)
  departureAirportName String                @db.VarChar(200)
  departureAirportCity String?               @db.VarChar(120)
  departureCountryCode String?               @db.VarChar(2)
  departureTimeZone    String                @db.VarChar(100)
  arrivalAirportCode   String                @db.VarChar(3)
  arrivalAirportName   String                @db.VarChar(200)
  arrivalAirportCity   String?               @db.VarChar(120)
  arrivalCountryCode   String?               @db.VarChar(2)
  arrivalTimeZone      String                @db.VarChar(100)
  scheduledDepartureAt DateTime
  scheduledArrivalAt   DateTime
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  statusSnapshot       FlightStatusSnapshot?

  @@index([tripId, leg, scheduledDepartureAt])
}

enum FlightStatusLookupResult {
  found
  not_found
}

enum FlightStatusCode {
  unknown
  scheduled
  delayed
  departed
  arrived
  cancelled
  possibly_cancelled
  diverted
}

/// Latest verified provider status for one flight segment. Provider times are
/// stored separately from the segment's own scheduled times, which are never
/// rewritten by status updates.
model FlightStatusSnapshot {
  id                           Int                      @id @default(autoincrement())
  segmentId                    Int                      @unique
  segment                      FlightSegment            @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  /// Segment updatedAt at lookup time; a later itinerary edit invalidates the snapshot.
  sourceSegmentUpdatedAt       DateTime
  provider                     String                   @db.VarChar(40)
  lookupResult                 FlightStatusLookupResult
  status                       FlightStatusCode         @default(unknown)
  providerScheduledDepartureAt DateTime?
  estimatedDepartureAt         DateTime?
  actualDepartureAt            DateTime?
  providerScheduledArrivalAt   DateTime?
  estimatedArrivalAt           DateTime?
  actualArrivalAt              DateTime?
  providerUpdatedAt            DateTime?
  fetchedAt                    DateTime
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
}

enum RecoveryActivityType {
  sleep
  light
  meal
  hydration
  exercise
  caffeine
}

enum RecoveryDirection {
  east
  west
  none
}

model RecoveryPlan {
  id                        Int                @id @default(autoincrement())
  tripId                    Int
  trip                      Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Outbound plans adjust to the destination; return plans adjust back home.
  leg                       JourneyLeg         @default(outbound)
  sourceTripUpdatedAt       DateTime
  sourceItineraryHash       String             @db.VarChar(64)
  destinationTimeZone       String             @db.VarChar(100)
  journeyDurationMinutes    Int
  direction                 RecoveryDirection
  timeZoneChangeMinutes     Int
  estimatedTimeZonesCrossed Int
  recoveryDays              Int
  targetBedtime             String             @db.VarChar(5)
  targetWakeTime            String             @db.VarChar(5)
  avoidCaffeine             Boolean            @default(false)
  preparationDaysAvailable  Int                @default(0)
  assumptions               String[]
  /// Route endpoints used for this plan, including applied flight-status times.
  routeDepartureAt          DateTime?
  routeArrivalAt            DateTime?
  /// Hash of the material flight-status times the plan was generated with.
  flightStatusSignature     String?            @db.VarChar(64)
  adjustmentNote            String?            @db.VarChar(1000)
  adjustedAt                DateTime?
  generatedAt               DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  activities                RecoveryActivity[]

  @@unique([tripId, leg])
}

model RecoveryActivity {
  id          Int                  @id @default(autoincrement())
  planId      Int
  plan        RecoveryPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  activityKey String               @db.VarChar(32)
  dayNumber   Int
  type        RecoveryActivityType
  title       String               @db.VarChar(120)
  guidance    String               @db.VarChar(1000)
  scheduledAt DateTime
  /// End of the activity window; null for activities created before end times were stored.
  endsAt      DateTime?
  timeZone    String               @db.VarChar(100)
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([planId, activityKey])
  @@index([planId, scheduledAt])
}
