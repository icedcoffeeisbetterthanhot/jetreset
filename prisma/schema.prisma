generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal connectivity model used for health checks.
/// Not tied to future business features and safe to remove later.
model AppHealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  note      String
}
